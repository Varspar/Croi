# Copy this file to .env at the project root and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Database (used by docker-compose's croi-db service and the backend) ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=croi

# --- OpenRouter (chat completions) ---
# Get a key at https://openrouter.ai/keys
# Model ids are provider-prefixed, e.g. anthropic/claude-3-haiku — a bare
# model name will return a "model not found" error.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-haiku

# --- JWT ---
# Must be at least 32 characters. Generate your own for anything beyond local dev.
JWT_SECRET=change-this-super-secret-key-min-32-characters-long
